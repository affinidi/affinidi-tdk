{
  "name": "@affinidi-tdk/auth-provider",
  "version": "1.35.4",
  "description": "Internal module for managing access tokens",
  "author": "Affinidi",
  "repository": {
    "type": "git",
    "url": "https://github.com/affinidi/affinidi-tdk"
  },
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "affinidi-tdk",
    "identity",
    "holistic",
    "network",
    "trust"
  ],
  "license": "Apache-2.0",
  "main": "index.js",
  "typings": "index.d.ts",
  "sideEffects": false,
  "files": [
    "*.js",
    "*.d.ts",
    "helpers/**/*.js",
    "helpers/**/*.d.ts"
  ],
  "homepage": "https://github.com/affinidi/affinidi-tdk#readme",
  "engines": {
    "node": ">=20.x"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix"
  },
  "dependencies": {
    "@affinidi-tdk/common": "^1.0.0",
    "@types/jsonwebtoken": "^9.0.3",
    "@types/qs": "^6.9.8",
    "@types/uuid": "^9.0.8",
    "axios": "^1.18.1",
    "jose": "^5.9.3",
    "jsonwebtoken": "^9.0.3",
    "qs": "^6.15.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.4.0",
    "@typescript-eslint/parser": "^7.4.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "typescript": "^5.2.2"
  },
  "stability": "stable",
  "types": "index.d.ts",
  "typesVersions": {
    "<=3.9": {
      "*": [
        ".types-compat/ts3.9/*",
        ".types-compat/ts3.9/*/index.d.ts"
      ]
